# Settings for the FastAPI edition. Use a NEW Supabase project (never the live Next.js app's).
# Supabase → Project Settings → API.
SUPABASE_URL=https://YOUR-NEW-PROJECT-REF.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon public" key. Safe to expose.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
